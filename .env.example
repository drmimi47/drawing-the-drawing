# Mapbox access token. Leave blank to run with map mode disabled — the app stays
# fully usable via Blank sheet and Import, and the Map substrate is greyed out.
#
# This value is inlined into the client bundle at build time (VITE_ prefix), so it
# is public by construction. Use a URL-restricted public (pk.) token scoped to your
# own origins — never a secret (sk.) token.
VITE_MAPBOX_TOKEN=

# Optional: a published Mapbox Studio style URL. Defaults to mapbox/streets-v12.
# The token above must belong to the account that owns this custom style.
VITE_MAPBOX_STYLE=
